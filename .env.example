# Optional AI providers. Keep secret keys server-side; never use NEXT_PUBLIC_ for these.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional cloud login and sync. These are the Supabase project URL and publishable/anon key.
# Make sure Row Level Security is enabled and supabase/schema.sql has been applied.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
